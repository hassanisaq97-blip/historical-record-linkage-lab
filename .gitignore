__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.snakemake/

# Synthetic data and intermediate pipeline artefacts are regenerated
# deterministically by `snakemake --snakefile workflow/Snakefile --cores 1`
# (fixed random seed, see linkage_lab/config.py). Not committed to keep the
# repository small; results/ (reports + figures) is committed as evidence.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# nyc_directories real-world source data CANNOT be reliably re-downloaded
# in a network-restricted environment (see docs/limitations.md) and is
# small, plain-text, and MIT-licensed - vendored and committed instead.
!data/raw/nyc_directories/
data/processed/nyc_directories/*
!data/processed/nyc_directories/.gitkeep
